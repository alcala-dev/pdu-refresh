# Generated manifests — contain BMC IPs and serials. Never commit.
*_manifest_*.csv
manifest*.csv
*.csv

# Local scratch / working files
scratch/
tmp/
*.tmp
*.log
*.bak

# Local scope allowlists (site- or wave-specific)
scope*.txt

# NOTE: completed/<site>/done_racks.txt is deliberately TRACKED, not ignored —
# these are the shared completion ledgers and must be identical for everyone
# running the tracker. One ledger per site so regions never mix:
#   completed/rno2/done_racks.txt
#   completed/us-west-02/done_racks.txt
#   completed/us-west-04/done_racks.txt
# Keep private what-if ledgers out of the way with DONE_FILE / --done instead.

# Snapshots live under snapshots/<site>/. The *.csv rule above covers them, so a
# snapshot you want to keep must be force-added (`git add -f`) — and remember
# those manifests carry BMC IPs and serials.

# macOS / editor cruft
.DS_Store
.vscode/
.idea/
*.swp
